// Dimensions (in meters)
a = 5 * 10^-2;
b = 4 * 10^-2;
c = 10 * 10^-2;

// Conductivity of copper
C = 5.8 * 10^7;

// Permeability of free space
Uo = 4 * %pi * 10^-7;

// Resonant frequency for TE101 mode
f101 = 3.335 * 10^9;

// Skin depth
d = sqrt(1 / (%pi * f101 * Uo * C));

// Quality factor
Q = ((a^2 + c^2) * a * b * c) / (d * (2 * b * (a^3 + c^3) + a * c * (a^2 + c^2)));

disp(Q, "Quality factor of TE101 = ");
