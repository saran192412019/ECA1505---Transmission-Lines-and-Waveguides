clc;
clear;
close;

// TE10 Mode

a = 8.636 * 10^-2;
b = 4.318 * 10^-2;

f = 4 * 10^9;
V = 3 * 10^8;

m = input("Enter the value of m = ");
n = input("Enter the value of n = ");

// Cut-off frequency
fc = (V / 2) * sqrt((m / a)^2 + (n / b)^2);

disp(fc * 10^-9, "Cut-off frequency (GHz) = ");

// Phase velocity
A = V / sqrt(1 - (fc / f)^2);

disp(A * 10^-6, "Phase velocity (Mm/sec) = ");

// Group velocity
B = V * V / A;

disp(B * 10^-6, "Group velocity (Mm/sec) = ");
