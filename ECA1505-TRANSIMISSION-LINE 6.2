clc;
clear;

// Constants
C = 5.8 * 10^7;
Uo = 4 * %pi * 10^-7;
f101 = 3.335 * 10^9;

// Skin depth
d = sqrt(1 / (%pi * f101 * Uo * C));

// Initial values
Qmax = 0;
amax = 0;
bmax = 0;
cmax = 0;

// Vary dimensions
for a = 0.04:0.005:0.06
for b = 0.03:0.005:0.05
for c = 0.08:0.01:0.12

Q = ((a^2 + c^2) * a * b * c) / ...
(d * (2 * b * (a^3 + c^3) + a * c * (a^2 + c^2)));

if Q > Qmax then
Qmax = Q;
amax = a;
bmax = b;
cmax = c;
end
end
end
end

disp(amax, "Optimal a (m) = ");
disp(bmax, "Optimal b (m) = ");
disp(cmax, "Optimal c (m) = ");
disp(Qmax, "Maximum Q-factor = ");
