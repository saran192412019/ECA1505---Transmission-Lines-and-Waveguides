clc;
clear;

// Fixed dimensions
b = 4 * 10^-2;      // 4 cm
c = 10 * 10^-2;     // 10 cm

// Constants
C = 5.8 * 10^7;
Uo = 4 * %pi * 10^-7;
f101 = 3.335 * 10^9;

// Skin depth
d = sqrt(1 / (%pi * f101 * Uo * C));

// Vary a from 4 cm to 6 cm
for a = 0.04:0.005:0.06

    Q = ((a^2 + c^2) * a * b * c) / ...
        (d * (2 * b * (a^3 + c^3) + a * c * (a^2 + c^2)));

    disp(a * 100, "a (cm) = ");
    disp(Q, "Q-factor = ");
    disp("-----------------------");

end
