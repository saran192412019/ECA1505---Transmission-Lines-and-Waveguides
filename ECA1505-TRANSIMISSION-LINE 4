clear;
clc;
ZR = 100;
Zo = 600;
f = 100 * (10^6);
lo = 300 / (f * 10^-6);
Ls = (lo / (2 * %pi)) * atan(sqrt(ZR / Zo));
mprintf("Point of attachment = %.1f cm\n", round(Ls * 1000) / 10);
Lt = (lo / (2 * %pi)) * (%pi + atan(sqrt(ZR * Zo) / (ZR - Zo)));
mprintf("Length of the short-circuited stub = %.0f cm\n", round(Lt * 100));
