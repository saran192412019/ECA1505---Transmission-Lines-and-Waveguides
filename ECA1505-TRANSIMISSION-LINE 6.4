clc;
clear;

// Fixed dimensions
a = 5 * 10^-2;      // 5 cm
c = 10 * 10^-2;     // 10 cm

// Constants
C = 5.8 * 10^7;
Uo = 4 * %pi * 10^-7;
f101 = 3.335 * 10^9;

// Skin depth
d = sqrt(1 / (%pi * f101 * Uo * C));

// Vary b from 3 cm to 5 cm
for b = 0.03:0.005:0.05

    Q = ((a^2 + c^2) * a * b * c) / ...
        (d * (2 * b * (a^3 + c^3) + a * c * (a^2 + c^2)));

    disp(b * 100, "b (cm) = ");
    disp(Q, "Q-factor = ");
    disp("-----------------------");

end
